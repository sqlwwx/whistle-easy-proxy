{
  "name": "whistle.easy-proxy",
  "version": "1.0.0",
  "description": "EasyProxy whistle plugin — GitHub acceleration, SNI rewrite, hosts management",
  "main": "index.js",
  "homepage": "https://github.com/sqlwwx/easy-proxy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqlwwx/easy-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/sqlwwx/easy-proxy/issues"
  },
  "author": "sqlwwx",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "files": [
    "index.js",
    "bin/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "easy-proxy": "bin/easy-proxy.js",
    "whistle.easy-proxy": "bin/easy-proxy.js"
  },
  "whistleConfig": {
    "hideShortProtocol": true,
    "hideLongProtocol": true
  },
  "keywords": [
    "whistle",
    "plugin",
    "easy-proxy",
    "github",
    "acceleration",
    "sni",
    "hosts"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "whistle": "^2.10.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "easy-proxy start",
    "stop": "easy-proxy stop",
    "test": "node --test",
    "health": "easy-proxy health",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7"
  }
}
